    { "path": "pages/home/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/workbench/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/messages/index", "style": { "navigationStyle": "custom", "enablePullDownRefresh": true, "onReachBottomDistance": 120 } },
    { "path": "pages/quick-report/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/equipment/index", "style": { "navigationStyle": "custom", "enablePullDownRefresh": true, "onReachBottomDistance": 120 } },
    { "path": "pages/equipment/detail", "style": { "navigationStyle": "custom" } },
    { "path": "pages/schedule/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/risk/index", "style": { "navigationStyle": "custom", "enablePullDownRefresh": true, "onReachBottomDistance": 120 } },
    { "path": "pages/risk/detail", "style": { "navigationStyle": "custom" } },
    { "path": "pages/inspection/index", "style": { "navigationStyle": "custom", "enablePullDownRefresh": true, "onReachBottomDistance": 120 } },
    { "path": "pages/inspection/detail", "style": { "navigationStyle": "custom" } },
    { "path": "pages/hazards/index", "style": { "navigationStyle": "custom", "enablePullDownRefresh": true, "onReachBottomDistance": 120 } },
    { "path": "pages/hazards/detail", "style": { "navigationStyle": "custom" } },
